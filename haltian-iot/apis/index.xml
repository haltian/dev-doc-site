 &lt;td>&lt;code>ambientTemperature&lt;/code>&lt;/td>
 &lt;/tr>
 &lt;tr>
 &lt;td>Data Type&lt;/td>
 &lt;td>&lt;code>numeric&lt;/code>&lt;/td>
 &lt;/tr>
 &lt;tr>
